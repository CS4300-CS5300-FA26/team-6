# Local development environment variables.
# Copy this file to `.env` and adjust the values for your machine.
# `.env` is ignored by Git; do not commit real secrets.

# Set to `True` to enable Django debug mode locally; accepted true values include
# `true`, `on`, `ok`, `y`, `yes`, and `1`. Do not set DEBUG on production environments.
DJANGO_DEBUG=True

# Comma-separated origins including scheme, e.g. https://app-name.lab.devedu.io
# DJANGO_CSRF_TRUSTED_ORIGINS=https://app-mightyraven6850-28.lab.devedu.io

# Development placeholder only. Unique key is used in production.
DJANGO_SECRET_KEY=fake-secret-key