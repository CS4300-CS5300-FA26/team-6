# Copy this file to .env for local development. Never commit real secrets.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=fake-secret-key

# Comma-separated origins including scheme when running behind a proxy.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-development-host.example

# School Canvas origin, without /api/v1 or a trailing path.
CANVAS_BASE_URL=

# Generate once with Fernet.generate_key(); see README. Keep this key stable.
CANVAS_TOKEN_ENCRYPTION_KEY=

# OpenAI API key for inference; never commit a real value.
OPENAI_API_KEY=

# Set all four for private production uploads; leave all empty for local filesystem storage.
BUCKETEER_AWS_ACCESS_KEY_ID=
BUCKETEER_AWS_SECRET_ACCESS_KEY=
BUCKETEER_AWS_REGION=
BUCKETEER_BUCKET_NAME=
